    <diagram id="codex-cctp-bridge-flow" name="CCTP Bridge Flow">
        <mxGraphModel dx="1650" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1320" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="codex-cctp-bridge-title" value="CCTP Bridge Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="420" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-bridge-note" value="Bidirectional native USDC bridge: EVM -&gt; Stellar and Stellar -&gt; EVM. Backend validates, tracks burn, polls Circle attestation, relays mint, and refreshes portfolio." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="920" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-app-lane" value="SwiftEx Mobile App" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="460" height="1180" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-backend-lane" value="SwiftEx Proxy Server" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="620" height="1180" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-external-lane" value="External Systems" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="90" width="420" height="1180" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-screen" value="&lt;b&gt;1. Open CCTP Bridge Screen&lt;/b&gt;&lt;div&gt;Select source chain, destination chain, USDC amount and destination wallet&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="130" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-validate" value="&lt;b&gt;2. Quote + Validate&lt;/b&gt;&lt;div&gt;Check route, domains, wallet context, balances, allowance and destination format&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="130" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-order" value="&lt;b&gt;3. Create Bridge Order&lt;/b&gt;&lt;div&gt;Track source pending, attested, destination submitted, completed or failed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="260" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-builder" value="&lt;b&gt;4. Build Source Burn Payload&lt;/b&gt;&lt;div&gt;EVM transaction request or Stellar deposit_for_burn XDR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="390" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-evm-signer" value="&lt;b&gt;4a. Sign EVM Source Tx&lt;/b&gt;&lt;div&gt;Approve if needed, then sign depositForBurn&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="360" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-stellar-signer" value="&lt;b&gt;4b. Sign Stellar Source XDR&lt;/b&gt;&lt;div&gt;Sign deposit_for_burn XDR locally&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="520" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-submit-source" value="&lt;b&gt;5. Submit Source Burn&lt;/b&gt;&lt;div&gt;Broadcast the signed burn transaction on the source chain&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="520" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-source-contracts" value="&lt;b&gt;CCTP Source Contracts&lt;/b&gt;&lt;div&gt;EVM or Stellar TokenMessenger burns native USDC&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="520" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-source-tracker" value="&lt;b&gt;6. Source Tx Tracker&lt;/b&gt;&lt;div&gt;Wait for confirmed source burn and message hash&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="650" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-rpc" value="&lt;b&gt;EVM RPC / Blockscout / Soroban RPC&lt;/b&gt;&lt;div&gt;Receipts, confirmations and fallback transaction status&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="650" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-attestation" value="&lt;b&gt;7. Attestation Poller&lt;/b&gt;&lt;div&gt;Poll Circle Iris until the burn message is attested&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="780" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-cctp-iris" value="&lt;b&gt;Circle Iris Attestation API&lt;/b&gt;&lt;div&gt;Returns signed attestation for the burn message&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="780" width="330" height="86" as="geometry"/>
                </mxCell>
