                    <mxGeometry x="40" y="20" width="420" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-note" value="Stellar-only swap flow. Backend keeps SoroSwap API key server-side, validates wallet.xlm, builds XDR, app signs, backend submits and tracks status." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="900" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-app-lane" value="SwiftEx Mobile App" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="460" height="1090" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-backend-lane" value="SwiftEx Proxy Server" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="560" y="90" width="620" height="1090" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-external-lane" value="External Systems" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;startSize=32;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="90" width="420" height="1090" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-screen" value="&lt;b&gt;1. Open SoroSwap Screen&lt;/b&gt;&lt;div&gt;Select Stellar asset pair, amount, slippage and requested wallet.xlm&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="130" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-controller" value="&lt;b&gt;2. Validate Request&lt;/b&gt;&lt;div&gt;Check Stellar network, wallet.xlm, balances, trustline, slippage and route expiry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="130" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-quote-service" value="&lt;b&gt;3. Quote Service&lt;/b&gt;&lt;div&gt;Ask SoroSwap for best route and expected output&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="300" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-route-ui" value="&lt;b&gt;4. Show Quote / Route&lt;/b&gt;&lt;div&gt;Expected output, min received, price impact, provider split and expiry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="80" y="300" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-xdr-builder" value="&lt;b&gt;5. Build Swap XDR&lt;/b&gt;&lt;div&gt;Build trustline XDR if needed and unsigned Soroban swap XDR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="470" width="330" height="86" as="geometry"/>
                </mxCell>
                <mxCell id="codex-soroswap-trustline-ui" value="&lt;b&gt;6. Trustline Prompt&lt;/b&gt;&lt;div&gt;Optional changeTrust signature when the destination asset is missing&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="80" y="470" width="330" height="86" as="geometry"/>
                </mxCell>
