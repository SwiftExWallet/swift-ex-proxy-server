    <diagram id="ejlkOSbV8rhqz-ehEuVz" name="G-L1">
        <mxGraphModel dx="1916" dy="570" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="codex-g-l1-description" value="&lt;b&gt;G-L1 Description&lt;/b&gt;&lt;div&gt;This diagram represents the core SwiftEx backend architecture for a multi-chain wallet and DEX platform. Users access wallets, send/receive assets, swaps/trades, bridge and DeFi flows, portfolio, PNL, app availability, market data, fiat on/off-ramp, and notifications through the mobile app and SwiftEx Proxy Server. The proxy server owns provider integrations, validation, order tracking, portfolio refresh, notifications, Redis state, and MongoDB persistence while transaction signing remains in the user wallet.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="-610" y="-80" width="1590" height="110" as="geometry"/>
                </mxCell>
