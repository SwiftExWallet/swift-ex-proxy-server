                <mxCell id="codex-soroswap-submit-service" value="&lt;b&gt;8. Submit Signed XDR&lt;/b&gt;&lt;div&gt;Send signed payload through SoroSwap API or Soroban fallback&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;spacing=8;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="650" y="640" width="330" height="86" as="geometry"/>
                </mxCell>
