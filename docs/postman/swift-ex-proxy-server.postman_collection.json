            "url": "{{baseUrl}}/api/v1/swap/1inch/submitFusionPlusNativeOrder"
          }
        },
        {
          "name": "Custom Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Swap update\",\"body\":\"Your swap status changed.\",\"data\":{\"txHash\":\"{{txHash}}\",\"orderHash\":\"{{orderHash}}\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/swap/1inch/customNotification"
          }
        }
      ]
    },
    {
      "name": "Swap Orders",
      "item": [
        {
          "name": "Store Swap Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-wallet-address",
                "value": "{{walletAddress}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"quoteId\":\"{{quoteId}}\",\"txHash\":\"{{txHash}}\",\"provider\":\"ONEINCH_FUSION\",\"fromChain\":\"ETH\",\"toChain\":\"BSC\",\"fromToken\":\"ETH\",\"toToken\":\"USDT\",\"amountIn\":\"0.1\",\"amountOut\":\"100\",\"txType\":\"Swap\",\"status\":\"pending\",\"usdValue\":100}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/swapOrders/store"
          }
        },
        {
          "name": "Orders By Wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-wallet-address",
                "value": "{{walletAddress}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/swapOrders/orderByWallet?address={{walletAddress}}&page=1&limit=10"
          }
        },
        {
          "name": "Order By Hash",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-wallet-address",
                "value": "{{walletAddress}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/swapOrders/{{orderHash}}?address={{walletAddress}}"
          }
        }
      ]
    }
  ]
