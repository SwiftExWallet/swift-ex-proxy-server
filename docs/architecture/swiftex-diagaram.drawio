    <diagram id="codex-soroswap-flow" name="SoroSwap Flow">
        <mxGraphModel dx="1650" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
